*
*  Expected WRR (ROM port 0) outputs, bus value during X2:
*   period   70: port <-  0 (0000)
*   period  142: port <-  1 (0001)
*   period 1782: port <-  2 (0010)
*   period 2422: port <-  3 (0011)
*   period 4302: port <-  4 (0100)
*   period 4982: port <-  5 (0101)
*   period 5390: port <-  6 (0110)
*   period 5806: port <-  7 (0111)
*   period 45870: port <- 10 (1010)
*
*  Output-port writes expected from the ISA model (instruction cycle: value):
*   cycle      6: WMP RAM bank 0 chip 0 <- 0
*   cycle      7: WRR ROM port 0 <- 0
*   cycle     16: WRR ROM port 0 <- 1
*   cycle    221: WRR ROM port 0 <- 2
*   cycle    301: WRR ROM port 0 <- 3
*   cycle    536: WRR ROM port 0 <- 4
*   cycle    621: WRR ROM port 0 <- 5
*   cycle    672: WRR ROM port 0 <- 6
*   cycle    724: WRR ROM port 0 <- 7
*   cycle   5728: WMP RAM bank 0 chip 0 <- 1
*   cycle   5732: WRR ROM port 0 <- 10

* long run: only the pins are saved (delete the .save line to keep every node)
.save V(d0) V(d1) V(d2) V(d3) V(sync) V(cmrom) V(cmram0) V(cmram1) V(cmram2) V(cmram3) V(phi1) V(phi2) V(reset) V(busval) I(VVDD)
.meas TRAN PORT_OUT1 FIND V(busval) AT={(70+0.8)*TCLK}
.meas TRAN PORT_OUT2 FIND V(busval) AT={(142+0.8)*TCLK}
.meas TRAN PORT_OUT3 FIND V(busval) AT={(1782+0.8)*TCLK}
.meas TRAN PORT_OUT4 FIND V(busval) AT={(2422+0.8)*TCLK}
.meas TRAN PORT_OUT5 FIND V(busval) AT={(4302+0.8)*TCLK}
.meas TRAN PORT_OUT6 FIND V(busval) AT={(4982+0.8)*TCLK}
.meas TRAN PORT_OUT7 FIND V(busval) AT={(5390+0.8)*TCLK}
.meas TRAN PORT_OUT8 FIND V(busval) AT={(5806+0.8)*TCLK}
.meas TRAN PORT_OUT9 FIND V(busval) AT={(45870+0.8)*TCLK}
.meas TRAN IDD_AVG AVG I(VVDD) FROM={8*TCLK} TO={TSTOP}
.meas TRAN P_AVG PARAM IDD_AVG*VDDV
.tran {TCLK/40} {TSTOP} 0 {TCLK/40}
.end
